{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/events/ContradictionRecorded/v1.json",
  "title": "ContradictionRecorded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_ref",
    "predicate"
  ],
  "properties": {
    "subject_ref": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "contradicting_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
