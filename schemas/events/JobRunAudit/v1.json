{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/events/JobRunAudit/v1.json",
  "title": "JobRunAudit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "stage_name",
    "action"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "stage_name": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "details": {
      "type": "object"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
