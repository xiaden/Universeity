{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/events/OverrideApplied/v2.json",
  "title": "OverrideApplied",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_ref",
    "predicate",
    "object_ref"
  ],
  "properties": {
    "subject_ref": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "relationship_type": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Plan U P2-S4: the normalized relationship type this override targets (RELATED_TO edges). Null for untyped predicates."
    },
    "authority": {
      "const": "USER_OVERRIDE"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
