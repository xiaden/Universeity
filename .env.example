# =============================================================================
# Universal Media Decomposer — environment example
# Copy to `.env` (git-ignored) and adjust. Every value is overridable via
# real environment variables with the `UMD_` prefix (pydantic-settings for the
# app surface; the worker-subprocess vars below read directly from the
# environment).
# NESTED SETTINGS RULE: for nested `Settings` fields pydantic-settings honors
# names that nest with `__` (e.g. `UMD_POSTGRES__DSN` -> settings.postgres.dsn,
# `UMD_OCFL__ROOT` -> settings.ocfl.root). The single-underscore nesting variant
# of these names is SILENTLY IGNORED (extra="ignore") - always use `__` to nest.
# In production ALWAYS set secrets via the environment, never this file.
# =============================================================================

# --- General ---------------------------------------------------------------
# Log level: DEBUG|INFO|WARNING|ERROR
UMD_LOG_LEVEL=INFO

# --- PostgreSQL (transactional authority for source/segment/ledger) ---------
# SQLAlchemy connection string. psycopg3 driver.
UMD_POSTGRES__DSN=postgresql+psycopg://umd:umd@127.0.0.1:5432/umd
# Alembic uses this same DSN for structural migrations.
UMD_POSTGRES__POOL_SIZE=10
UMD_POSTGRES__MAX_OVERFLOW=20

# --- OCFL object storage (sole authority for raw source bytes + fixity) -----
# Filesystem root for the OCFL 1.1 storage root. In production this may back a
# MinIO-compatible bucket; the adapter treats the substrate as replaceable.
UMD_OCFL__ROOT=./.ocfl-root
# OCFL layout extension (see OCFL spec storage layouts).
UMD_OCFL__LAYOUT=0003-hash-and-id-n-tuple-storage-layout

# --- Limits (security bounds) ----------------------------------------------
# Maximum accepted single raw source upload in bytes.
UMD_LIMITS__MAX_UPLOAD_BYTES=1073741824
# Maximum byte range size returned by source-native retrieval.
UMD_LIMITS__MAX_RANGE_BYTES=1048576
# Maximum number of bytes read from OCFL into memory per retrieval.
UMD_LIMITS__MAX_READ_BUFFER_BYTES=1048576

# --- Consistency / lag budget (Tier-1 reads) -------------------------------
# Bounded lag budget in seconds, cap <= 1s per the DD.
UMD_LAG_BUDGET_SECONDS=1.0

# --- Simulated stage manifests (dev only) -----------------------------------
# Digest algorithm used for content addressing, validated by fixtures.
UMD_DIGEST_ALGORITHM=sha512

# --- Worker-side (sandbox) environment ----------------------------------------
# The decomposition worker subprocesses derive their config from these env vars
# (see umd/audio/config.py, umd/video/config.py, umd/subtitle/config.py). They are
# read directly from the environment during decoding, NOT via pydantic-settings.
# Keep secrets and weights paths out of this file; set them in the environment.
#
# Audio baseline (Phase 2)
UMD_ASR_ENGINE=reference             # reference | faster-whisper (GATED)
UMD_ASR_MODEL_DIR=                   # offline ASR weights dir (faster-whisper, GATED)
UMD_AUDIO_DECLARED_LANGUAGE=         # optional declared language hint
UMD_AUDIO_LANGUAGE=                  # optional configuration language
UMD_DIARIZATION_ENABLED=false        # enable gated pyannote diarization
UMD_DIARIZATION_WEIGHTS_DIR=         # pinned offline pyannote weights dir (GATED)
UMD_DIARIZATION_LEGAL_GATE=false     # pyannote weights legal/commercial sign-off (Q1/U1)
UMD_AUDIO_MAX_DURATION_S=0.0         # 0 = no duration ceiling
UMD_AUDIO_CONFIDENCE_THRESHOLD=0.45
UMD_AUDIO_ENERGY_CORR_THRESHOLD=0.5
#
# Video baseline (Phase 3)
UMD_VIDEO_MAX_DURATION_S=0.0         # 0 = no duration ceiling
UMD_VIDEO_SCENE_THRESHOLD=0.3
UMD_VIDEO_MAX_SCENES=512
UMD_VIDEO_MAX_FRAMES=2000
UMD_SCENE_ENGINE_PYSCENEDETECT=false # GATED enhancer; reference ffmpeg scene used
UMD_VIDEO_DECODE_PYAV=false          # GATED PyAV decode; reference ffmpeg used
#
# Subtitle baseline (Phase 3)
UMD_SUBTITLE_FORMAT=                 # force a subtitle format, else autodetect
UMD_SUBTITLE_MAX_EVENTS=20000
UMD_SUBTITLE_NORMALIZE_WEBVTT=true   # mandatory X-TIMESTAMP-MAP pre-normalization
#
# Model provider (Phase 1)
UMD_VLLM_ENABLED=false               # enable the gated vLLM adapter
#
# Shared worker digest override (normally derived by the config *_config_from_env)
UMD_CONFIG_DIGEST=

# --- Hatchet release scheduler (sole v1 scheduler; worker + release runner) ----
# The decomposition DAG is scheduled by Hatchet. These are the deployment-time
# values the compose worker/API read (via the `UMD_` prefix for the worker env
# and UMD_HATCHET_* in build_hatchet_client). The token MUST be a REAL tenant JWT
# minted AFTER hatchet-admin has generated /hatchet/config. The umd-ci-token
# placeholder is NOT a JWT and can never register a worker. Mint with:
#   docker compose run --no-deps hatchet-admin /hatchet/hatchet-admin token create \
#       --config /hatchet/config --tenant-id <uuid>
# then export the token as HATCHET_TENANT_TOKEN (a JWT starts with `ey`).
HATCHET_COOKIE_SECRET=            # required ($HATCHET_COOKIE_SECRET:?) by compose
HATCHET_MASTER_KEY=               # required ($HATCHET_MASTER_KEY:?) by compose
HATCHET_TENANT_TOKEN=             # real tenant JWT (minted via hatchet-admin)
HATCHET_DASHBOARD_PORT=8081       # host port for the Hatchet dashboard UI
# gRPC admin address for the SDK (routes to the ENGINE, never the dashboard).
HATCHET_CLIENT_HOST_PORT=localhost:7070
# Hatchet server HTTP URL (worker gate + release submission client).
UMD_HATCHET_SERVER_URL=http://localhost:8081
UMD_HATCHET_TOKEN=${HATCHET_TENANT_TOKEN}